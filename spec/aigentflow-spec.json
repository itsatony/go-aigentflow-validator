    "script",
    "search",
    "shelly",
    "staticmap",
    "storage",
    "transform",
    "wait",
    "web",
    "worldbank"
  ],
  "dataTypes": ["string", "number", "integer", "boolean", "object", "array", "null", "binary"],
  "errorStrategyActions": ["retry", "fail", "goto", "continue"],
  "retryOnCategories": [
    "transient",
    "rate_limit",
    "auth",
    "validation",
    "resource",
    "fatal",
    "unknown"
  ],
  "nextMarkers": ["null", "end", "orchestrator"],
  "parallelResolutions": ["all-complete", "all-succeed", "first-succeed", "first-complete"],
  "forEachResolutions": ["all-complete", "all-succeed"],
  "loopMaxIterationsLimit": 1000,
  "credentialReferencePrefix": "stored/",
  "executorUrlPattern": "^([a-zA-Z0-9-]+)://([a-zA-Z0-9_-]+)/([a-zA-Z0-9_/-]+)$",
  "templateActionOpen": "{{",
  "evalJudgeUrl": "eval://judge/evaluate",
  "qualityGate": {
    "$comment": "DC-CP-8: the quality_gate: step block. on_fail 'human' exists in the Go enum but is validation-REJECTED (pending the human-task inbox), so it is NOT in onFailActions and is flagged as rejected here.",
    "onFailActions": ["fail", "goto", "retry"],
    "onFailRejected": ["human"],
    "thresholdMin": 0,
    "thresholdMax": 1
  },
  "inputSchema": {
    "types": [
      "string",
      "multiline",
      "number",
      "bool",
      "enum",
      "array_of_strings",
      "date",
      "file",
      "secret"
    ],
    "stringTypes": ["string", "multiline", "secret"],
    "parametricTypes": ["number", "enum"],
    "fieldNamePattern": "^[a-z][a-z0-9_]*$",
    "datePattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "maxPatternLength": 512,
    "maxConstraintValue": 1048576,
    "maxInputKeyCount": 256,
    "maxStringInputLength": 1048576
  },
  "orchestrator": {
    "modes": ["monitor", "owner"],
    "triggers": [
      "step_completed",
      "step_failed",
      "mission_started",
      "mission_completed",
      "dfm_suggestion",
      "timer",
      "request_turn",
      "mission_recovered",
      "campaign_child_completed",
      "campaign_child_failed",
      "human_response",
      "human_input"
    ],
    "tools": [
      "aif_step_cancel",
      "aif_step_start",
      "aif_step_inspect",
      "aif_conversation_manage",
      "aif_request_turn",
      "aif_checkpoint_create",
      "aif_mission_complete",
      "aif_mission_fail",
