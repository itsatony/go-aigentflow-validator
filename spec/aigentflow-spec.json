    ]
  },
  "processingOperations": {
    "$comment": "Pre/post-processing operation dispatch set and per-operation config keys. The key sets are PER OPERATION and must never be unioned: `asset_id` is read by binary.get/update/delete and is NOT read by binary.transform, which reads `source_asset_id`.",
    "guardKey": "if",
    "standardTypes": [
      "data.set",
      "conversation.append",
      "output.set",
      "binary.store",
      "binary.get",
      "binary.update",
      "binary.delete",
      "binary.transform",
      "parse"
    ],
    "loopSubStepTypes": ["loop.set", "loop.break"],
    "openKeyTypes": ["data.set", "output.set", "conversation.append", "loop.set"],
    "closedConfigKeys": {
      "parse": ["source", "format", "target", "on_error"],
      "binary.store": ["data", "metadata", "result_key"],
      "binary.get": ["asset_id", "include_data", "result_key"],
      "binary.update": ["asset_id", "data", "metadata"],
      "binary.delete": ["asset_id"],
      "binary.transform": [
        "source_asset_id",
        "transformer",
        "parameters",
        "metadata",
        "result_key"
      ],
      "loop.break": ["if"]
    }
  },
