      "aif_tool_discover",
      "aif_tool_execute",
      "aif_trove_upload",
      "aif_trove_download",
      "aif_trove_list",
      "aif_trove_delete",
      "aif_e2b_sandbox_create",
      "aif_e2b_sandbox_execute",
      "aif_e2b_sandbox_files",
      "aif_e2b_desktop_screenshot",
      "aif_e2b_desktop_interact"
    ]
  },
  "expressionFunctions": {
    "namePrefix": "fn_",
    "catalog": [
      "fn_avg",
      "fn_camelCase",
      "fn_chunk",
      "fn_clamp",
      "fn_compact",
      "fn_kebabCase",
